{
    "name": "@nesgarbo/feathers-redis-cache",
    "description": "Redis/Dragonfly cache for Feathers service (v5-friendly, ESM)",
    "version": "1.2.4",
    "type": "module",
    "homepage": "https://github.com/nesgarbo/feathers-redis-cache",
    "repository": {
        "type": "git",
        "url": "git://github.com/nesgarbo/feathers-redis-cache.git"
    },
    "author": {
        "name": "Néstor García",
        "email": "nesgarbo@icloud.com"
    },
    "license": "MIT",
    "keywords": [
        "feathers",
        "feathersjs",
        "hooks",
        "redis",
        "dragonfly",
        "cache",
        "feathers-redis-cache",
        "feathers-v5",
        "esm"
    ],
    "engines": {
        "node": ">=22"
    },
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "files": [
        "build",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "rm -rf build && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "jest",
        "prepare": "npm run build",
        "release": "semantic-release",
        "commit": "npm run build && npx git-cz && git push",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "ioredis": "^5.8.1",
        "pino": "^10.0.0",
        "pino-pretty": "^13.1.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@feathersjs/feathers": "^5.0.35",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.0",
        "@semantic-release/npm": "^13.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.8.0",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "jest": "^30.2.0",
        "prettier": "^3.6.2",
        "semantic-release": "^25.0.0",
        "typescript": "^5.9.3"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false
}
